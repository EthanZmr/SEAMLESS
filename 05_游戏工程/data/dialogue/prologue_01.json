{
  "meta": {
    "id": "prologue_01",
    "title": "雨市",
    "subtitle": "SEAMLESS · 无缝",
    "note": "序章对白。改这里不需要碰 prologue.gd。"
  },
  "lines": [
    {
      "who": "旁白",
      "text": "地下诊所。雨。霓虹。头顶是磁悬浮轨道。空气里有焊锡和消毒水味。",
      "color": "#6F8FA8"
    },
    {
      "who": "阿绫",
      "text": "他这条手臂，第三次了。",
      "color": "#FF8FB0"
    },
    {
      "who": "阿针",
      "text": "第三次便宜。",
      "color": "#BFF7F0"
    },
    {
      "who": "骑手",
      "text": "能撑到月底吗？",
      "color": "#D9E6F2"
    },
    {
      "who": "阿针",
      "text": "能撑到明天。",
      "color": "#BFF7F0"
    },
    {
      "who": "阿绫",
      "text": "你又在吓客人。",
      "color": "#FF8FB0"
    },
    {
      "who": "阿针",
      "text": "我说的是实话。",
      "color": "#BFF7F0"
    },
    {
      "who": "阿绫",
      "text": "实话才吓人。",
      "color": "#FF8FB0"
    },
    {
      "who": "骑手",
      "text": "针姐，外面在传，白城要把雨市“量”了。",
      "color": "#D9E6F2"
    },
    {
      "who": "阿针",
      "text": "量了又怎样？",
      "color": "#BFF7F0"
    },
    {
      "who": "骑手",
      "text": "量完就剪。剪完就回收。你这条街，尺寸不合。",
      "color": "#D9E6F2"
    },
    {
      "who": "阿绫",
      "text": "你为什么不告诉他，接口快烧了？",
      "color": "#FF8FB0"
    },
    {
      "who": "阿针",
      "text": "告诉他，他今晚就睡不着了。",
      "color": "#BFF7F0"
    },
    {
      "who": "阿绫",
      "text": "把坏消息缝在别人看不见的地方。",
      "color": "#FF8FB0"
    },
    {
      "who": "旁白",
      "text": "警报。窗外，白色回收车驶过。门被敲响。白露站在雨里，没打伞，身上一滴水都没有。",
      "color": "#6F8FA8"
    },
    {
      "who": "白露",
      "text": "阿针。好久不见。",
      "color": "#FFFFFF"
    },
    {
      "who": "阿针",
      "text": "你认错人了。",
      "color": "#BFF7F0"
    },
    {
      "who": "白露",
      "text": "你左肩下面，有一针红线。我缝的。",
      "color": "#FFFFFF"
    },
    {
      "who": "阿绫",
      "text": "姐……",
      "color": "#FF3E8A"
    },
    {
      "who": "白露",
      "text": "她还在，对吗？",
      "color": "#FFFFFF"
    },
    {
      "who": "阿针",
      "text": "你到底要什么？",
      "color": "#BFF7F0"
    },
    {
      "who": "白露",
      "text": "跟我回白城。我把她还给我，把你还给你。",
      "color": "#FFFFFF"
    },
    {
      "who": "阿针",
      "text": "怎么还？",
      "color": "#BFF7F0"
    },
    {
      "who": "白露",
      "text": "拆开。干净、无痛、一次就好。",
      "color": "#FFFFFF"
    },
    {
      "who": "阿针",
      "text": "……你管这叫“还”？",
      "color": "#BFF7F0"
    },
    {
      "who": "白露",
      "text": "我管这叫“不再疼”。",
      "color": "#FFFFFF"
    },
    {
      "who": "旁白",
      "text": "远处，回收车的门开了。清道夫下车。",
      "color": "#6F8FA8"
    },
    {
      "who": "白露",
      "text": "我给你三天。三天后，我来接她。",
      "color": "#FFFFFF"
    },
    {
      "who": "阿绫",
      "text": "……她以前，不这样。",
      "color": "#FF8FB0"
    },
    {
      "who": "阿针",
      "text": "人都这样。",
      "color": "#BFF7F0"
    },
    {
      "who": "阿绫",
      "text": "你也这样吗？",
      "color": "#FF8FB0"
    },
    {
      "who": "阿针",
      "text": "我哪样？",
      "color": "#BFF7F0"
    },
    {
      "who": "阿绫",
      "text": "把坏消息缝起来。",
      "color": "#FF8FB0"
    },
    {
      "who": "旁白",
      "text": "门被撞开。两名清道夫冲进来。",
      "color": "#6F8FA8"
    }
  ]
}
