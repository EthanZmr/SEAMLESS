; Engine configuration file.
; 《无缝》SEAMLESS — vertical slice whitebox
; Godot 4.7

config_version=5

[application]

config/name="无缝 SEAMLESS"
config/description="A 2D cyberpunk action vertical slice: dual consciousness, seam parry, Rain Market."
run/main_scene="res://scenes/prologue.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DebugLog="*res://scripts/autoload/debug_log.gd"
Fonts="*res://scripts/autoload/fonts.gd"
Settings="*res://scripts/autoload/settings.gd"
Loc="*res://scripts/autoload/loc.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
InputRebind="*res://scripts/autoload/input_rebind.gd"
InputBuffer="*res://scripts/autoload/input_buffer.gd"
GameState="*res://scripts/autoload/game_state.gd"
GameEvents="*res://scripts/autoload/game_events.gd"
LevelManager="*res://scripts/autoload/level_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
HitStop="*res://scripts/autoload/hit_stop.gd"

[importer_defaults]

texture={
"mipmaps/generate": true
}

[internationalization]

locale/translations=PackedStringArray("res://data/loc/strings.zh.translation", "res://data/loc/strings.en.translation")
locale/fallback="zh"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043137, 0.070588, 0.12549, 1)
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="interact"
